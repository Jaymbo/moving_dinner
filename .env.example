# Moving Dinner - Environment Variables Template
# Kopiere diese Datei als .env und fülle die Werte aus.
# NEVER commit .env files to git!

# ============================================
# Backend Configuration
# ============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://movingdinner:movingdinner@localhost:5432/movingdinner

# JWT Secret (min. 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production-min-32-chars-long

# Server Port
PORT=3001

# Environment
NODE_ENV=development

# Base URL for email links (frontend URL)
BASE_URL=http://localhost:3000

# ============================================
# SMTP Configuration (Email Delivery)
# ============================================
# Use a relay service like Resend, Brevo, SendGrid, etc.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Moving Dinner <noreply@example.com>

# ============================================
# Frontend Configuration (if needed)
# ============================================
# Vite loads these with VITE_ prefix

# VITE_API_URL=http://localhost:3001
